// Schema de referência da plataforma — cobre as entidades centrais do
// estoque/CRM (vehicles, vehicle_photos, leads, lead_interactions,
// consent_records etc.). Ainda NÃO inclui os módulos adicionados depois
// direto sobre o mock store (análise de crédito completa, negociações/
// documentação, vendedores/marketing, precificação FIPE, nem os campos de
// integração com o Mercado Livre em Vehicle) — trazer essas entidades para
// cá é um passo futuro.
//
// DATABASE_URL (usada pelo Prisma Migrate — ver prisma.config.ts) já aponta
// para um Postgres real no Supabase, e as tabelas abaixo foram criadas lá
// via `npx prisma migrate dev`. O app em si (lib/server/db.ts) ainda lê e
// grava no mock store em `data/db.json` em tempo de execução — migrar de
// fato a camada de dados para consultar este banco via Prisma Client é um
// passo separado, ainda não feito.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identidade e acesso (seção 16/23)
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MANAGER
  SALES
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SALES)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee?

  leadsOwned        Lead[]             @relation("LeadOwner")
  interactions      LeadInteraction[]
  appointments      Appointment[]
  proposals         Proposal[]
  sales             Sale[]
  aiRecommendations AiRecommendation[]

  @@map("users")
}

model Employee {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String? // cargo livre (ex: "Consultor de vendas")
  phone    String?
  photoUrl String?

  @@map("employees")
}

// ---------------------------------------------------------------------------
// Clientes e consentimento (LGPD — seções 10 e 25)
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String
  cpf       String? // coletado apenas quando estritamente necessário
  birthDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads                  Lead[]
  favorites              Favorite[]
  financingRequests      FinancingRequest[]
  creditAnalysisRequests CreditAnalysisRequest[]
  tradeInRequests        TradeInRequest[]
  appointments           Appointment[]
  proposals              Proposal[]
  sales                  Sale[]
  consentRecords         ConsentRecord[]

  @@map("customers")
}

enum ConsentType {
  DATA_PROCESSING
  CREDIT_CHECK
  MARKETING
}

model ConsentRecord {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       ConsentType
  granted    Boolean
  text       String // texto exato apresentado ao titular no momento do consentimento
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@map("consent_records")
}

// ---------------------------------------------------------------------------
// Estoque de veículos (seções 6, 7, 20, 21)
// ---------------------------------------------------------------------------

enum VehicleStatus {
  AVAILABLE // Disponível
  RESERVED // Reservado
  SOLD // Vendido
  PREPARING // Em preparação
}

enum Transmission {
  MANUAL
  AUTOMATIC
  CVT
  AUTOMATED
}

enum FuelType {
  FLEX
  GASOLINE
  ETHANOL
  DIESEL
  HYBRID
  ELECTRIC
}

enum BodyType {
  HATCH
  SEDAN
  SUV
  PICKUP
  MINIVAN
  COUPE
  CONVERTIBLE
}

model Vehicle {
  id               String        @id @default(cuid())
  slug             String        @unique
  brand            String
  model            String
  version          String
  bodyType         BodyType
  manufactureYear  Int
  modelYear        Int
  mileageKm        Int
  price            Decimal       @db.Decimal(12, 2)
  costPrice        Decimal?      @db.Decimal(12, 2) // interno — nunca exposto no frontend
  transmission     Transmission
  fuel             FuelType
  color            String
  plateEnding      String? // final da placa
  doors            Int           @default(4)
  engine           String?
  powerHp          Int?
  trunkLiters      Int?
  fuelConsumption  String?
  licensePlate     String? // placa completa — uso interno
  features         String[] // principais equipamentos
  description      String?
  videoUrl         String?
  status           VehicleStatus @default(AVAILABLE)
  enteredStockAt   DateTime      @default(now())
  soldAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  photos            VehiclePhoto[]
  favorites         Favorite[]
  leads             Lead[]
  financingRequests FinancingRequest[]
  tradeInRequests   TradeInRequest[] @relation("DesiredVehicle")
  appointments      Appointment[]
  proposals         Proposal[]
  sale              Sale?
  aiRecommendations AiRecommendation[]

  @@index([status])
  @@index([brand, model])
  @@map("vehicles")
}

model VehiclePhoto {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("vehicle_photos")
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionId  String? // visitante anônimo (antes do cadastro)
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([sessionId, vehicleId])
  @@map("favorites")
}

// ---------------------------------------------------------------------------
// Marketing e origem de leads (seção 22)
// ---------------------------------------------------------------------------

model MarketingSource {
  id        String   @id @default(cuid())
  channel   String // Google Ads, Meta Ads, Instagram, WhatsApp, Indicação...
  utmSource String?
  utmMedium String?
  utmCampaign String?
  costCents Int? // custo atribuído, quando disponível
  createdAt DateTime @default(now())

  leads Lead[]

  @@map("marketing_sources")
}

// ---------------------------------------------------------------------------
// CRM / Funil comercial (seções 6→19)
// ---------------------------------------------------------------------------

enum LeadStage {
  NEW // Novo Lead
  CONTACTED // Contato realizado
  QUALIFIED // Qualificado
  VISIT // Visita/Test-drive
  PROPOSAL // Proposta
  FINANCING // Financiamento
  SOLD // Venda
  LOST // Perdido
}

enum LeadOrigin {
  SITE
  WHATSAPP
  IA_RECOMMENDATION
  TRADE_IN
  FINANCING_SIMULATOR
  CREDIT_PREANALYSIS
  MARKETPLACE
  REFERRAL
  OTHER
}

model Lead {
  id                String     @id @default(cuid())
  customerId        String?
  customer          Customer?  @relation(fields: [customerId], references: [id])
  name              String
  email             String?
  phone             String
  vehicleId         String?
  vehicle           Vehicle?   @relation(fields: [vehicleId], references: [id])
  origin            LeadOrigin @default(SITE)
  marketingSourceId String?
  marketingSource   MarketingSource? @relation(fields: [marketingSourceId], references: [id])
  stage             LeadStage  @default(NEW)
  ownerId           String?
  owner             User?      @relation("LeadOwner", fields: [ownerId], references: [id])
  message           String?
  leadScore         Int?       // Lead Score comercial (0-100) — seção 18, distinto de score de crédito
  nextActionAt      DateTime?
  nextActionNote    String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  interactions      LeadInteraction[]
  appointments      Appointment[]
  proposals         Proposal[]
  financingRequests FinancingRequest[]
  aiRecommendations AiRecommendation[]

  @@index([stage])
  @@map("leads")
}

enum InteractionChannel {
  WHATSAPP
  PHONE
  EMAIL
  SITE
  IN_PERSON
  SYSTEM
}

model LeadInteraction {
  id        String              @id @default(cuid())
  leadId    String
  lead      Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?               @relation(fields: [userId], references: [id])
  channel   InteractionChannel
  note      String
  createdAt DateTime            @default(now())

  @@map("lead_interactions")
}

model Appointment {
  id         String   @id @default(cuid())
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  vehicleId  String?
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  scheduledFor DateTime
  kind       String   @default("visit") // visit | test_drive
  status     String   @default("scheduled") // scheduled | done | canceled | no_show
  notes      String?
  createdAt  DateTime @default(now())

  @@map("appointments")
}

model Proposal {
  id         String   @id @default(cuid())
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  vehicleId  String?
  vehicle    Vehicle? @relation(fields: [vehicleId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  offeredPrice Decimal @db.Decimal(12, 2)
  downPayment  Decimal? @db.Decimal(12, 2)
  status       String   @default("open") // open | accepted | rejected | expired
  createdAt    DateTime @default(now())

  sale Sale?

  @@map("proposals")
}

model Sale {
  id          String   @id @default(cuid())
  vehicleId   String   @unique
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  proposalId  String?  @unique
  proposal    Proposal? @relation(fields: [proposalId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  finalPrice  Decimal  @db.Decimal(12, 2)
  soldAt      DateTime @default(now())

  @@map("sales")
}

// ---------------------------------------------------------------------------
// Financiamento e crédito (seções 9, 10)
// ---------------------------------------------------------------------------

model FinancingRequest {
  id             String   @id @default(cuid())
  leadId         String?
  lead           Lead?    @relation(fields: [leadId], references: [id])
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  vehicleId      String?
  vehicle        Vehicle? @relation(fields: [vehicleId], references: [id])
  vehiclePrice   Decimal  @db.Decimal(12, 2)
  downPayment    Decimal  @db.Decimal(12, 2)
  financedAmount Decimal  @db.Decimal(12, 2)
  termMonths     Int
  monthlyIncome  Decimal? @db.Decimal(12, 2)
  estimatedInstallment Decimal? @db.Decimal(12, 2) // simulação estimada — nunca uma oferta real
  status         String   @default("simulated") // simulated | submitted | in_review | approved | denied
  createdAt      DateTime @default(now())

  @@map("financing_requests")
}

enum CreditAnalysisStatus {
  PENDING_CONSENT
  AWAITING_PROVIDER // aguardando integração com bureau/instituição autorizada
  UNAVAILABLE_DEMO // ambiente de demonstração, sem integração ativa
  COMPLETED
  FAILED
}

// Status comercial do funil pós-consulta (seção 11 do briefing) — distinto
// de CreditAnalysisStatus, que descreve só o ciclo de vida da CHAMADA à
// Serasa. Mock store em lib/server/db.ts já implementa esse fluxo completo
// sobre data/db.json; os campos abaixo espelham exatamente o que está lá.
enum CommercialStatus {
  NEW
  CREDIT_CHECKED
  SIMULATING
  PROPOSAL_SENT
  AWAITING_BANK
  APPROVED_BY_FINANCIER
  REJECTED_BY_FINANCIER
  SALE_COMPLETED
}

model CreditAnalysisRequest {
  id            String                @id @default(cuid())
  customerId    String
  customer      Customer              @relation(fields: [customerId], references: [id])
  vehicleId     String?
  vehicleInterest String? // texto livre informado no formulário (pode não bater com o estoque)
  vehiclePrice  Decimal?              @db.Decimal(12, 2)
  monthlyIncome Decimal?              @db.Decimal(12, 2)
  downPayment   Decimal?              @db.Decimal(12, 2)
  desiredInstallment Decimal?         @db.Decimal(12, 2)
  hasTradeIn    Boolean               @default(false)
  consentRecordId String?
  status        CreditAnalysisStatus  @default(PENDING_CONSENT)
  commercialStatus CommercialStatus   @default(NEW)
  sellerId      String? // User.id do vendedor que solicitou a consulta
  providerName  String? // nome do bureau/financeira quando integrado ("SERASA_EXPERIAN" | "DEMO")
  providerRefId String? // referência externa da consulta — nunca o score bruto exposto sem necessidade
  score         Int? // score retornado (0-1000) — null quando indisponível
  scoreClassification String? // faixa/classificação retornada pelo provedor contratado, nunca inventada
  riskIndicator String?
  indicatorsJson Json? // restrições, pendências, protestos, cheques, negativações, consultas, cadastro positivo
  factorsJson   Json? // fatores que impactam o score, conforme retornados pela consulta
  aiSummary     String? // texto gerado pela camada de interpretação (lib/creditAI.ts) — nunca "aprovado"
  aiScenario    String? // FAVORABLE | INTERMEDIATE | RISK
  resultSummary String? // preenchido somente após integração real
  consultedAt   DateTime?
  createdAt     DateTime              @default(now())

  @@map("credit_analysis_requests")
}

// ---------------------------------------------------------------------------
// Avaliação / troca de usados (seção 11)
// ---------------------------------------------------------------------------

model TradeInRequest {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  plate           String
  brand           String
  model           String
  version         String?
  year            Int
  mileageKm       Int
  color           String
  hasFinancing    Boolean  @default(false)
  expectedValue   Decimal? @db.Decimal(12, 2)
  desiredVehicleId String?
  desiredVehicle  Vehicle? @relation("DesiredVehicle", fields: [desiredVehicleId], references: [id])
  photos          String[] // urls (frente, traseira, laterais, interior, painel)
  status          String   @default("submitted") // submitted | evaluating | offered | accepted | rejected
  offeredValue    Decimal? @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  @@map("trade_in_requests")
}

// ---------------------------------------------------------------------------
// IA (seções 8, 12, 18, 19)
// ---------------------------------------------------------------------------

enum AiRecommendationKind {
  VEHICLE_MATCH // "encontre seu carro com IA"
  COMPARISON // comparador com IA
  LEAD_COPILOT // resumo/copiloto de vendedor
}

model AiRecommendation {
  id          String               @id @default(cuid())
  kind        AiRecommendationKind
  leadId      String?
  lead        Lead?                @relation(fields: [leadId], references: [id])
  userId      String?              // vendedor que solicitou (copiloto)
  user        User?                @relation(fields: [userId], references: [id])
  vehicleId   String?              // veículo avaliado/recomendado
  vehicle     Vehicle?             @relation(fields: [vehicleId], references: [id])
  inputPrompt String // texto livre do usuário / contexto do lead
  outputJson  Json // resultado estruturado — sempre restrito a veículos do estoque real
  createdAt   DateTime             @default(now())

  @@map("ai_recommendations")
}

// ---------------------------------------------------------------------------
// Tabela-ponte (não é o modelo relacional "de verdade" descrito acima)
// ---------------------------------------------------------------------------
//
// Guarda o mesmo objeto DbShape que lib/server/db.ts já manipula em memória,
// agora persistido no Postgres em vez de um arquivo local em disco — resolve
// a falta de disco compartilhado entre instâncias serverless da Vercel (cada
// requisição podia cair numa instância com seu próprio /tmp, então uma
// escrita não era visível na leitura seguinte). Uma única linha (id fixo
// "singleton"). Migrar de fato para as tabelas relacionais acima é um passo
// futuro, se um dia for necessário.
model MockStore {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt

  @@map("mock_store")
}
