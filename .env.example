# Copie para .env.local e ajuste os valores. Nada aqui deve conter segredos
# reais em commits — este arquivo é apenas o template (seção 25 do briefing).

# Banco de dados (schema em prisma/schema.prisma). Enquanto não estiver
# definida, o app usa o mock store em data/db.json (ver lib/server/db.ts).
DATABASE_URL="postgresql://user:password@localhost:5432/auto2000"

# Sessão do painel administrativo (mock — ver lib/server/auth.ts)
AUTH_SECRET="troque-por-um-segredo-forte-em-producao"
ADMIN_EMAIL="admin@auto2000.com.br"
ADMIN_PASSWORD="auto2000admin"

# WhatsApp (número usado no botão flutuante e nos CTAs de contato)
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"

# SEO / sitemap
NEXT_PUBLIC_SITE_URL="https://www.auto2000.com.br"

# Análise Inteligente de Crédito — integração oficial e contratada com a
# Serasa Experian (ver lib/server/serasa.ts). Enquanto as quatro variáveis
# abaixo não estiverem todas definidas, o módulo roda em MODO DEMO: os dados
# retornados são fictícios e sempre identificados como tal na interface.
# Nunca faça scraping ou automação do site da Serasa — apenas a API oficial.
SERASA_API_URL=
SERASA_CLIENT_ID=
SERASA_CLIENT_SECRET=
SERASA_API_KEY=
SERASA_ENVIRONMENT="sandbox"

# --- Integrações futuras (não implementadas — apenas placeholders) ---
# FINANCEIRA_API_KEY=
# WHATSAPP_BUSINESS_API_TOKEN=
# GOOGLE_ANALYTICS_ID=
# META_PIXEL_ID=
